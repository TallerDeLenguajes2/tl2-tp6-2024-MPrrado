<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - tl2_tp6_2024_MPrrado</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/tl2_tp6_2024_MPrrado.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <H1 class="text-center">TALLER DE LENGUAJES II - 2024</H1>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 justify-content-center">
                        @inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor //// Inyecto las dependencias para acceder al HttpContext
                        @if (HttpContextAccessor.HttpContext.Session.GetString("Rol") == "Administrador" ) // no se me ocurrio mejor forma que esta, por ahora no pude romperlo
                        {
                            <li class="nav-item mx-2">
                                <a class="nav-link btn btn-primary text-white fw-bold" asp-area="" asp-controller="Productos" asp-action="Index">Productos</a>
                            </li>
                            <li class="nav-item mx-2">
                                <a class="nav-link btn btn-primary text-white fw-bold" asp-area="" asp-controller="Cliente" asp-action="Index">Clientes</a>
                            </li>
                        }
                        <li class="nav-item mx-2">
                            <a class="nav-link btn btn-primary text-white fw-bold" asp-area="" asp-controller="Presupuestos" asp-action="Index">Presupuestos</a>
                        </li>
                    </ul>
                     <ul class="navbar-nav d-flex justify-content-center lista-nav pe-2 mt-1">
                            @if (HttpContextAccessor.HttpContext.Session.GetString("IsAuthenticated") == "true") //mismo que arriba
                            {
                                <li class="nav-item dropdown">
                                    <a class=" text-dark btn btn-dark fw-bold text-white rounded-pill" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Cuenta
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end bg-secondary" aria-labelledby="navbarDropdown">
                                        <li><a class="nav-link btn text-white fw-bold btn-dark my-2" asp-controller="Login" asp-action="Logout">Salir</a></li>
                                        <li><a class="nav-link btn text-white fw-bold btn-dark my-2" href="#">Cancelar</a></li>
                                    </ul>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark btn btn-dark fw-bold text-white rounded-pill" asp-controller="Login" asp-action="Index">Login</a>
                                </li>
                            }
                        </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2024 - tl2_tp6_2024_MPrrado - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
